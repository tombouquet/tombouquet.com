{
  "name": "tombouquet.com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install || true",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "blurhash": "2.0.5",
    "react": "19.3.1",
    "react-blurhash": "0.3.0",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@tombouquet/commitlint-config": "0.2.0",
    "@tombouquet/format-codemod": "0.2.0",
    "@tombouquet/oxfmt-config": "0.2.0",
    "@tombouquet/oxlint-config": "0.3.0",
    "@tombouquet/tsconfig": "0.2.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "happy-dom": "21.0.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "trustedDependencies": [
    "@swc/core",
    "lefthook"
  ]
}
